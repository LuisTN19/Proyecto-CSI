Future<List<Map<String, dynamic>>> getPlatos() async {
    try {
      final response = await http.get(  //realizamos la petición get
        Uri.parse(_baseUrl),
        headers: _token(),
      );

      //laravel


      if (response.statusCode == 200) { //coge el JSON q le ha enviado laarvel y lo convierte a dart
        final List<dynamic> data = jsonDecode(response.body);

        return data.map((item) {
          //LIMPIA INGREDIENTES, antes de ser utilizados
          //Al cambiar el envío de datos a Multipart (para enviar la foto), Laravel empezó a guardar los ingredientes a veces como Texto ("['A','B']") en vez de como JSON. -> type 'String' is not a subtype of type 'Iterable'
          List<String> listaIngredientes = [];

          if (item['ingredientes'] is List) { // Caso ideal: Laravel manda una lista
            listaIngredientes = List<String>.from(item['ingredientes']);
          } else if (item['ingredientes'] is String) { // Caso sucio: Laravel mandó texto "['A','B']", intentamos limpiarlo
            try {
              var decodificado = jsonDecode(item['ingredientes']); //jsonDecode para quitarle las comillas y convertirlo en lista real.
              listaIngredientes = List<String>.from(decodificado);
            } catch (e) {
              listaIngredientes = [];
            }
          }

          return {
            'id': item['id'],
            'nombre': item['nombre'],
            'descripcion': item['descripcion'] ?? "",

            'ingredientes': listaIngredientes, // <--- USAMOS LA LISTA SEGURA

            'tiempo': item['tiempo'] ?? "",
            'calorias': item['calorias'] ?? "",
            'calificacion': (item['calificacion'] ?? 0).toDouble(),
            'favorito': item['favorito'] == 1 || item['favorito'] == true,
            'url': item['imagen_url'],
            'placeholderIcon': null,
          };
        }).toList().cast<Map<String, dynamic>>();

      } else {
        return [];
      }
    } catch (e, stackTrace) { // <--- AÑADE stackTrace
      print("🔴 ERROR GRAVE LEYENDO PLATOS: $e");
      print(stackTrace);

      return [];
    }
  }